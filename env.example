# Copy this file to .env and fill in your own values.
# Never commit .env or live credentials to GitHub.

APP_ENV=development
APP_NAME=PayPal RecoverIQ
APP_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-bytes
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL (async SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://recoveriq:recoveriq_local_password@localhost:5432/recoveriq

# Redis is used by Celery for jobs and scheduled reminders
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI provider. Set model to a model enabled for your API account.
OPENAI_API_KEY=
OPENAI_MODEL=

# PayPal: start in Sandbox. Switch to live only after account and country eligibility are confirmed.
PAYPAL_ENV=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
PAYPAL_HTTP_TIMEOUT_SECONDS=20

# Frontend origin(s), comma-separated
CORS_ORIGINS=["http://localhost:3000"]

# Operational safeguards
REMINDER_DAYS_BEFORE_DUE=1
REMINDER_DAYS_AFTER_DUE=[1,3,7]
MAX_REMINDERS_PER_INVOICE_PER_DAY=2
WEBHOOK_PROCESSING_QUEUE=paypal-webhooks
LOG_LEVEL=INFO
SENTRY_DSN=
