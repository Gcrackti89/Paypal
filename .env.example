# Copy this file to .env and fill in your values.
# Never commit .env or live credentials to Git.

# App
APP_ENV=development
APP_NAME=PayPal RecoverIQ
APP_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-bytes
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL (async SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://recoveriq:recoveriq_local_password@localhost:5432/recoveriq

# Redis (Celery broker + result backend)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# OpenAI - Required for AI invoice extraction
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# PayPal Sandbox - Required for invoice operations
# 1. Go to https://developer.paypal.com/dashboard/
# 2. Create a REST app under Sandbox
# 3. Copy Client ID and Secret below
# 4. Create a webhook pointing to your HTTPS URL/api/v1/webhooks/paypal
# 5. Copy the Webhook ID below
# IMPORTANT: Bangladesh is not currently listed as a supported PayPal merchant country.
# Use Sandbox for the hackathon. Contact PayPal or use an eligible merchant for production.
PAYPAL_ENV=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
PAYPAL_HTTP_TIMEOUT_SECONDS=20

# Frontend origins (comma-separated)
CORS_ORIGINS=["http://localhost:3000"]

# Recovery settings
REMINDER_DAYS_BEFORE_DUE=1
REMINDER_DAYS_AFTER_DUE=[1,3,7]
MAX_REMINDERS_PER_INVOICE_PER_DAY=2
WEBHOOK_PROCESSING_QUEUE=paypal-webhooks

# Logging
LOG_LEVEL=INFO

# Optional: Sentry error tracking
SENTRY_DSN=
